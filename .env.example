# Claude API key: powers "Extract workout" on the Add page. https://console.anthropic.com
ANTHROPIC_API_KEY=

# Postgres connection string (Neon via Vercel sets this automatically).
# Without it, data lives in memory and resets on restart.
DATABASE_URL=

# Optional: lock the site behind a sign-in page (password, then passkeys from Settings).
APP_PASSWORD=
# Optional: separate key for signing session cookies (defaults to APP_PASSWORD).
SESSION_SECRET=
