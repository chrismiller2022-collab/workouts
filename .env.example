# Claude API key: powers "Extract workout" on the Add page. https://console.anthropic.com
ANTHROPIC_API_KEY=

# Supabase (Project Settings → API). Without these, data lives in memory and resets on restart.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: require this password (HTTP Basic auth, any username) to open the site.
APP_PASSWORD=
